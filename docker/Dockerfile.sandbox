# =============================================================================
# WORKFLOW PLATFORM - PYTHON SANDBOX IMAGE
# =============================================================================
#
# Minimal, hardened Python image for secure code execution.
#
# Security Features:
# - Alpine-based minimal image (~50MB)
# - Non-root user (sandbox:sandbox)
# - No shell access (sh removed)
# - No package managers (apk removed)
# - No network tools
# - Read-only filesystem support
# - Minimal Python standard library
#
# Build:
#   docker build -t workflow-sandbox-python:latest -f docker/Dockerfile.sandbox .
#
# Test:
#   docker run --rm -it --network none --read-only \
#     --tmpfs /tmp:size=64m,mode=1777 \
#     workflow-sandbox-python:latest python3 -c "print('Hello')"
#
# =============================================================================

# Stage 1: Build stage
FROM python:3.11-alpine AS builder

# Install only necessary build tools
RUN apk add --no-cache \
    gcc \
    musl-dev \
    libffi-dev

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# No additional packages needed - using stdlib only


# Stage 2: Production stage
FROM python:3.11-alpine AS production

# Security: Create non-root user
RUN addgroup -g 1000 sandbox && \
    adduser -u 1000 -G sandbox -h /home/sandbox -D sandbox

# Copy Python from builder (if we had deps, we'd copy venv here)
# For stdlib-only, we just use the base Python

# Security: Remove unnecessary packages and tools
RUN apk del --purge \
    apk-tools \
    alpine-keys \
    scanelf \
    musl-utils \
    libc-utils || true

# Security: Remove shells and unnecessary binaries
RUN rm -f /bin/sh /bin/ash /bin/busybox 2>/dev/null || true
RUN rm -rf /sbin /usr/sbin 2>/dev/null || true

# Security: Remove package manager cache
RUN rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

# Security: Remove unnecessary Python components
RUN rm -rf \
    /usr/local/lib/python3.11/ensurepip \
    /usr/local/lib/python3.11/idlelib \
    /usr/local/lib/python3.11/tkinter \
    /usr/local/lib/python3.11/turtle* \
    /usr/local/lib/python3.11/test \
    /usr/local/lib/python3.11/lib2to3 \
    /usr/local/lib/python3.11/distutils \
    /usr/local/lib/python3.11/pydoc* \
    /usr/local/lib/python3.11/__pycache__/pydoc* \
    /usr/local/bin/pip* \
    /usr/local/bin/easy_install* \
    /usr/local/bin/wheel* \
    2>/dev/null || true

# Security: Make filesystem structure
RUN mkdir -p /sandbox /tmp && \
    chown sandbox:sandbox /sandbox /tmp && \
    chmod 755 /sandbox && \
    chmod 1777 /tmp

# Set working directory
WORKDIR /tmp

# Switch to non-root user
USER sandbox

# Security: Set restrictive environment
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    HOME=/tmp \
    PATH=/usr/local/bin:/usr/bin

# Health check - verify Python works
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python3 -c "print('ok')" || exit 1

# Default command
CMD ["python3"]


# =============================================================================
# ALTERNATIVE: Ultra-minimal distroless variant
# =============================================================================
# Uncomment below for even smaller attack surface (~25MB)
# Note: No shell at all, debugging harder

# FROM gcr.io/distroless/python3-debian11:nonroot
#
# WORKDIR /tmp
# USER nonroot
#
# ENV PYTHONDONTWRITEBYTECODE=1 \
#     PYTHONUNBUFFERED=1
#
# CMD ["python3"]
